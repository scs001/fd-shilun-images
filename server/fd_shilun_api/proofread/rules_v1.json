{
  "version": "proofread-v1",
  "rules": [
    {
      "id": "pf.p0.missing_element",
      "severity": "P0",
      "category": "必需要素",
      "match": {
        "kind": "required_field",
        "fields": [
          "title",
          "addressee",
          "issuer_signature",
          "date"
        ],
        "labels": {
          "title": "标题",
          "addressee": "主送机关",
          "issuer_signature": "发文机关署名",
          "date": "成文日期"
        }
      },
      "message": "公文缺少必需要素",
      "basis": "《党政机关公文处理工作条例》第九条：公文一般由份号、密级和保密期限、紧急程度、发文机关标志、发文字号、签发人、标题、主送机关、正文、附件说明、发文机关署名、成文日期、印章、附注、附件、抄送机关、印发机关和印发日期、页码等组成。"
    },
    {
      "id": "pf.p0.doc_number_format",
      "severity": "P0",
      "category": "发文字号",
      "match": {
        "kind": "field_format",
        "field": "doc_number",
        "checker": "doc_number"
      },
      "message": "发文字号格式不符合规范",
      "suggestion": "机关代字〔年份〕序号号，如：国发〔2024〕5号",
      "basis": "GB/T 9704-2012《党政机关公文格式》：发文字号由发文机关代字、年份、发文顺序号组成；年份用六角括号〔〕括入，发文顺序号不加「第」字、不编虚位。"
    },
    {
      "id": "pf.p0.date_format",
      "severity": "P0",
      "category": "成文日期",
      "match": {
        "kind": "field_format",
        "field": "date",
        "checker": "date"
      },
      "message": "成文日期格式不符合规范",
      "suggestion": "2024年5月1日",
      "basis": "GB/T 9704-2012《党政机关公文格式》：成文日期用阿拉伯数字将年、月、日标全，年份标全称，月、日不编虚位。"
    },
    {
      "id": "pf.p0.sensitive_word",
      "severity": "P0",
      "category": "敏感词",
      "match": {
        "kind": "literal",
        "patterns": [
          "法轮功",
          "六四事件",
          "台独",
          "藏独",
          "疆独",
          "东突",
          "达赖",
          "支那"
        ]
      },
      "message": "正文出现敏感词",
      "suggestion": "删除或按规范表述改写，并人工复核",
      "basis": "《新华社新闻信息报道中的禁用词和正确表述》及公文用语规范：敏感词命中须人工复核，不得径行发布。"
    },
    {
      "id": "pf.p1.cliche",
      "severity": "P1",
      "category": "套话",
      "match": {
        "kind": "literal",
        "patterns": [
          "高度重视",
          "狠抓落实",
          "进一步加强",
          "切实抓好",
          "扎实推进",
          "全面提升",
          "全力推进",
          "全面贯彻落实",
          "深入贯彻落实",
          "认真学习贯彻",
          "大力弘扬",
          "持续发力",
          "再上新台阶",
          "开创新局面"
        ]
      },
      "message": "正文出现套话",
      "suggestion": "改为可核查的具体举措、责任主体与时限，避免空泛表态",
      "basis": "《党政机关公文处理工作条例》要求公文「内容简洁、主题突出、观点鲜明、结构严谨、表述准确、文字精练」；空泛套话不提供可执行信息。"
    },
    {
      "id": "pf.p1.militarized",
      "severity": "P1",
      "category": "军事化表达",
      "match": {
        "kind": "literal",
        "patterns": [
          "挂图作战",
          "作战图",
          "军令状",
          "冲锋号",
          "歼灭战",
          "围剿",
          "战时状态",
          "火力全开",
          "全线出击",
          "死守"
        ]
      },
      "message": "正文出现军事化表达",
      "suggestion": "改用行政管理语汇（如「台账管理」「责任清单」「专项治理」）",
      "basis": "公文语言应准确、庄重、平实；军事化比喻易夸大对抗色彩、削弱政策表述的严肃性。"
    },
    {
      "id": "pf.p1.evasive",
      "severity": "P1",
      "category": "回避式表态",
      "match": {
        "kind": "regex",
        "patterns": [
          "(?:尚需|还需|有待|正在)(?:进一步)?研究",
          "视情况(?:而定|再定)",
          "原则上(?:同意|可以|不予|不)",
          "另行(?:通知|研究|确定|明确)",
          "暂(?:不|缓)(?:考虑|执行|实施|推进)",
          "以后再议",
          "无可奉告",
          "酌情(?:处理|办理|考虑)",
          "(?:视|按)情况(?:处理|办理)",
          "研究后(?:再|另行)定"
        ]
      },
      "message": "正文出现回避式表态",
      "suggestion": "给出明确结论、办理时限或责任单位，避免以「研究」「视情况」搁置事项",
      "basis": "《党政机关公文处理工作条例》要求公文表述准确、措施可行；回避式表态无法形成可执行、可追责的办理要求。"
    },
    {
      "id": "pf.p1.placeholder",
      "severity": "P1",
      "category": "占位符",
      "match": {
        "kind": "regex",
        "patterns": [
          "〔(?![0-9]{4}〕)[^〕\\n]{0,40}〕",
          "(?<![A-Za-z0-9/])[XxｘＸ]{2,}(?![A-Za-z0-9/])",
          "[×]{2,}",
          "(?<![A-Za-z])(?:TODO|TBD)(?![A-Za-z])",
          "待填(?:写|补)?|待补(?:充|齐)?",
          "_{4,}"
        ]
      },
      "message": "正文残留占位符",
      "suggestion": "按实际情况补全内容后删除占位标记",
      "basis": "成稿不得含未替换的占位内容；占位符一旦流出即造成要素缺失或事实空白。"
    },
    {
      "id": "pf.p1.punct_halfwidth",
      "severity": "P1",
      "category": "半角标点",
      "match": {
        "kind": "punctuation_halfwidth",
        "replacements": {
          ",": "，",
          ";": "；",
          ":": "：",
          "?": "？",
          "!": "！",
          "(": "（",
          ")": "）"
        }
      },
      "message": "正文使用半角标点",
      "suggestion": "中文行文改用全角标点",
      "basis": "GB/T 15834-2011《标点符号用法》：中文文稿的标点符号使用全角形式；半角标点仅在 ASCII 语串（网址、邮箱、数值）内部保留。"
    },
    {
      "id": "pf.p1.hierarchy_skip",
      "severity": "P1",
      "category": "层次序数",
      "match": {
        "kind": "hierarchy_skip"
      },
      "message": "层次序数跳级或格式不规范",
      "suggestion": "按「一、」→「（一）」→「1.」→「（1）」顺序编排；「1、」应写作「1.」",
      "basis": "GB/T 9704-2012《党政机关公文格式》7.3.3：公文结构层次序数依次可用「一、」「（一）」「1.」「（1）」标注。"
    },
    {
      "id": "pf.p2.punct_repeat",
      "severity": "P2",
      "category": "连续标点",
      "match": {
        "kind": "punctuation_repeat"
      },
      "message": "出现连续重复标点",
      "suggestion": "删去重复标点，保留一个",
      "basis": "GB/T 15834-2011《标点符号用法》：标点符号不得叠用（省略号、破折号等规范形式除外）。"
    },
    {
      "id": "pf.p2.typo",
      "severity": "P2",
      "category": "错别字",
      "match": {
        "kind": "literal",
        "patterns": [
          "布署",
          "截止目前",
          "截止到",
          "再接再励",
          "迫不急待",
          "相形见拙",
          "一如继往",
          "严竣",
          "既使",
          "按装",
          "做为"
        ],
        "suggestions": {
          "布署": "部署",
          "截止目前": "截至目前",
          "截止到": "截至",
          "再接再励": "再接再厉",
          "迫不急待": "迫不及待",
          "相形见拙": "相形见绌",
          "一如继往": "一如既往",
          "严竣": "严峻",
          "既使": "即使",
          "按装": "安装",
          "做为": "作为"
        }
      },
      "message": "疑似错别字",
      "suggestion": "按规范用字改正",
      "basis": "《现代汉语词典》及公文常用规范用字：上述词形为公认别字写法，规范词形见逐条建议。"
    }
  ]
}
